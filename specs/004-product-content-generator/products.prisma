// ============================================================
//  Products — billable educational catalog + content generation
//  Feature: 004-product-content-generator (Wave B)
//  - Unified tree: sessions → topics → scripts / materials
//  - Types: classroom | video_tutorial | video_pill
//  - Soft-delete on catalog/tree entities
//  - id: UUID v7 via uuid_generate_v7()
// ============================================================

enum ProductType {
  classroom
  video_tutorial
  video_pill

  @@map("product_type")
}

enum ProductStatus {
  draft
  published
  archived

  @@map("product_status")
}

enum ProductModality {
  online
  presential
  hybrid

  @@map("product_modality")
}

enum ScriptStatus {
  draft
  generated
  verified
  needs_review
  recorded

  @@map("script_status")
}

enum ContentGenerationStatus {
  pending
  parsing
  generating
  verifying
  rendering
  packaging
  completed
  failed

  @@map("content_generation_status")
}

enum MaterialType {
  pdf
  markdown
  link

  @@map("material_type")
}

enum VideoPlatform {
  youtube
  vimeo
  local
  other

  @@map("video_platform")
}

model Product {
  id            String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  clientId      String?          @map("client_id") @db.Uuid
  type          ProductType
  title         String           @db.VarChar(255)
  slug          String           @unique @db.VarChar(255)
  description   String?          @db.Text
  price         Decimal          @default(0) @db.Decimal(10, 2)
  currency      String           @default("EUR") @db.Char(3)
  status        ProductStatus    @default(draft)
  thumbnail     String?          @db.VarChar(2048)
  level         String           @default("beginner") @db.VarChar(50)
  language      String           @default("es") @db.VarChar(10)
  startDate     DateTime?        @map("start_date") @db.Date
  endDate       DateTime?        @map("end_date") @db.Date
  totalHours    Decimal?         @map("total_hours") @db.Decimal(8, 2)
  totalSessions Int?             @map("total_sessions")
  modality      ProductModality?
  notes         String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamp(6)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  classroom    Classroom?
  videoCourse  VideoCourse?
  sessions     ProductSession[]
  materials    ProductMaterial[]
  generations  ContentGeneration[]

  @@index([userId], map: "idx_products_user_id")
  @@index([clientId], map: "idx_products_client_id")
  @@index([type], map: "idx_products_type")
  @@index([status], map: "idx_products_status")
  @@index([deletedAt], map: "idx_products_deleted_at")
  @@index([deletedAt, createdAt], map: "idx_products_deleted_at_created_at")
  @@map("products")
}

model Classroom {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId    String    @unique @map("product_id") @db.Uuid
  maxStudents  Int?      @map("max_students")
  meetUrl      String?   @map("meet_url") @db.VarChar(2048)
  objectives   String?   @db.Text
  requirements String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, deletedAt], map: "idx_classrooms_product_deleted")
  @@map("classrooms")
}

model VideoCourse {
  id                   String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId            String         @unique @map("product_id") @db.Uuid
  platform             VideoPlatform?
  playlistUrl          String?        @map("playlist_url") @db.VarChar(2048)
  totalVideos          Int            @default(0) @map("total_videos")
  totalDurationMinutes Int?           @map("total_duration_minutes")
  targetAudience       String?        @map("target_audience") @db.Text
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, deletedAt], map: "idx_video_courses_product_deleted")
  @@map("video_courses")
}

model ProductSession {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  sessionNumber Int       @map("session_number")
  title         String    @db.VarChar(255)
  sessionDate   DateTime? @map("session_date") @db.Date
  startTime     DateTime? @map("start_time") @db.Time(6)
  endTime       DateTime? @map("end_time") @db.Time(6)
  hours         Decimal?  @db.Decimal(8, 2)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(6)

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  topics  ProductSessionTopic[]

  @@index([productId, sessionNumber], map: "idx_product_sessions_product_number")
  @@index([deletedAt], map: "idx_product_sessions_deleted_at")
  @@map("product_sessions")
}

model ProductSessionTopic {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productSessionId String    @map("product_session_id") @db.Uuid
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  hours            Decimal?  @db.Decimal(8, 2)
  sortOrder        Int       @default(1) @map("sort_order")
  sourcesJson      Json?     @map("sources_json") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(6)

  session   ProductSession    @relation(fields: [productSessionId], references: [id], onDelete: Cascade)
  script    ProductScript?
  materials ProductMaterial[]

  @@index([productSessionId, sortOrder], map: "idx_product_session_topics_session_sort")
  @@index([deletedAt], map: "idx_product_session_topics_deleted_at")
  @@map("product_session_topics")
}

model ProductScript {
  id                    String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productSessionTopicId String       @unique @map("product_session_topic_id") @db.Uuid
  intro                 String?      @db.Text
  body                  String?      @db.Text
  outro                 String?      @db.Text
  notes                 String?      @db.Text
  status                ScriptStatus @default(draft)
  estimatedMinutes      Int?         @map("estimated_minutes")
  generatedByModel      String?      @map("generated_by_model") @db.VarChar(100)
  sourcesJson           Json?        @map("sources_json") @db.JsonB
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime     @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamp(6)

  topic ProductSessionTopic @relation(fields: [productSessionTopicId], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_product_scripts_status")
  @@map("product_scripts")
}

model ProductMaterial {
  id                    String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId             String       @map("product_id") @db.Uuid
  productSessionTopicId String?      @map("product_session_topic_id") @db.Uuid
  title                 String       @db.VarChar(255)
  type                  MaterialType
  storageDisk           String?      @map("storage_disk") @db.VarChar(100)
  path                  String?      @db.VarChar(500)
  originalName          String?      @map("original_name") @db.VarChar(255)
  mimeType              String?      @map("mime_type") @db.VarChar(100)
  sizeBytes             BigInt?      @map("size_bytes")
  url                   String?      @db.VarChar(2048)
  content               String?      @db.Text
  isDownloadable        Boolean      @default(false) @map("is_downloadable")
  sortOrder             Int          @default(1) @map("sort_order")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime     @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamp(6)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  topic   ProductSessionTopic? @relation(fields: [productSessionTopicId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder], map: "idx_product_materials_product_sort")
  @@index([productSessionTopicId, sortOrder], map: "idx_product_materials_topic_sort")
  @@index([deletedAt], map: "idx_product_materials_deleted_at")
  @@map("product_materials")
}

model ContentGeneration {
  id              String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId       String                   @map("product_id") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  status          ContentGenerationStatus  @default(pending)
  mode            String                   @default("replace") @db.VarChar(20)
  sourceMarkdown  String                   @map("source_markdown") @db.Text
  model           String?                  @db.VarChar(100)
  progress        Int                      @default(0)
  sessionsCount   Int                      @default(0) @map("sessions_count")
  topicsCount     Int                      @default(0) @map("topics_count")
  scriptsCount    Int                      @default(0) @map("scripts_count")
  pdfPath         String?                  @map("pdf_path") @db.VarChar(500)
  mdPath          String?                  @map("md_path") @db.VarChar(500)
  zipPath         String?                  @map("zip_path") @db.VarChar(500)
  error           String?                  @db.Text
  startedAt       DateTime?                @map("started_at") @db.Timestamp(6)
  completedAt     DateTime?                @map("completed_at") @db.Timestamp(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime                 @default(now()) @map("updated_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status], map: "idx_content_generations_product_status")
  @@index([userId, createdAt], map: "idx_content_generations_user_created")
  @@map("content_generations")
}
