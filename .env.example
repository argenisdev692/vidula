VITE_REVERB_SCHEME="${REVERB_SCHEME}"


# ---- Email (Brevo SMTP — primary; Shared\Infrastructure\Mail\BrevoMailAdapter) ----
# MAIL_MAILER=brevo uses the dedicated `brevo` mailer in config/mail.php.
# Username = Brevo SMTP login (…@smtp-brevo.com) from Settings → SMTP & API.
# Password = SMTP key (xsmtpsib-…), NOT the REST API key (xkeysib-…).
# Port 587 → leave MAIL_SCHEME empty (STARTTLS). Port 465 → MAIL_SCHEME=smtps.
# Optional fallback: MAIL_MAILER=resend + RESEND_API_KEY=
MAIL_MAILER=brevo
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
#RESEND_API_KEY=


# --- Cloudflare R2 (S3-compatible) ---
FILESYSTEM_CLOUD=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET==
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=false

# ---- Product packages storage prefix ----
PRODUCT_PACKAGE_STORAGE_DISK=r2
PRODUCT_PACKAGE_STORAGE_DIRECTORY=ai/product-packages

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"


# ---- AI providers ----
# Select one: gemini | anthropic | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your_real_key_here
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Tavily (research / web search) ----
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# ---- Replicate (image generation) ----
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-2-pro
REPLICATE_IMAGE_ASPECT_RATIO=16:9
REPLICATE_IMAGE_OUTPUT_FORMAT=webp
REPLICATE_IMAGE_OUTPUT_QUALITY=85
REPLICATE_IMAGE_SAFETY_TOLERANCE=2
REPLICATE_IMAGE_PROMPT_UPSAMPLING=true
REPLICATE_WAIT_SECONDS=25
REPLICATE_STORAGE_DISK=r2
REPLICATE_STORAGE_DIRECTORY=ai/campaigns
REPLICATE_STORAGE_DIRECTORY_POSTS=ai/posts

HASH_DRIVER=argon2id
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

AUTH_LOCKOUT_ATTEMPTS=3
AUTH_LOCKOUT_MINUTES=60

AUTH_OTP_EXPIRES_MINUTES=2
AUTH_OTP_LENGTH=6
AUTH_OTP_VALID_CHARS=0123456789
AUTH_OTP_RESEND_INTERVAL_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=3
SESSION_LIFETIME=30

