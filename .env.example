APP_NAME=Vidula
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER="database"
SESSION_LIFETIME="30"
SESSION_ENCRYPT="false"
SESSION_PATH="/"
SESSION_DOMAIN="null"
SESSION_SECURE_COOKIE="true"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=382887
REVERB_APP_KEY=xcdkqluywit8roazwjzt
REVERB_APP_SECRET=puriqsdnbesak9lepzjj
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http
# Extra CSP origins (comma-separated). R2 (*.r2.cloudflarestorage.com) is
# already allowlisted in config/security.php for video-export XHR PUTs.
SECURITY_CSP_CONNECT_SRC=  # e.g. wss://your-reverb-host  (Reverb websockets)
SECURITY_CSP_IMG_SRC=      # optional extra image hosts beyond R2 + Google Maps


VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


# ---- Email (Brevo SMTP — primary; Shared\Infrastructure\Mail\BrevoMailAdapter) ----
# MAIL_MAILER=brevo uses the dedicated `brevo` mailer in config/mail.php.
# Username = Brevo SMTP login (…@smtp-brevo.com) from Settings → SMTP & API.
# Password = SMTP key (xsmtpsib-…), NOT the REST API key (xkeysib-…).
# Port 587 → leave MAIL_SCHEME empty (STARTTLS). Port 465 → MAIL_SCHEME=smtps.
# Optional fallback: MAIL_MAILER=resend + RESEND_API_KEY=
MAIL_MAILER=brevo
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
#RESEND_API_KEY=


# --- Cloudflare R2 (S3-compatible) ---
FILESYSTEM_CLOUD=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=false
# Comma-separated extra browser origins for R2 CORS (local Vite, prod host, etc.).
# Primary origin is always config('app.url') / APP_URL — do not repeat APP_URL here.
# On Railway set APP_URL=https://vidula.up.railway.app (it is included automatically).
# Shared R2 bucket across envs: list other env origins here (e.g. Railway while APP_URL is local).
R2_CORS_EXTRA_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost,https://*.argenis.dev,https://vidula.up.railway.app

# ---- FFmpeg (pbmedia/laravel-ffmpeg; facade FFMpeg via Package Discovery) ----
# Paths to binaries inside Sail/container (defaults work if ffmpeg is on PATH).
FFMPEG_BINARIES=ffmpeg
FFPROBE_BINARIES=ffprobe
# Optional scratch dir for laravel-ffmpeg temp files (empty = PHP sys_get_temp_dir).
FFMPEG_TEMPORARY_FILES_ROOT=
# Horizon queue name for video-export jobs (must match config/horizon.php supervisor).
VIDEO_EXPORT_QUEUE=video-export
# Local workspace for downloaded parts during a job (wiped after each run).
VIDEO_EXPORT_WORKSPACE=
# Low-memory FFmpeg profile (Railway / small containers). Default true.
# Caps threads + uses ultrafast + pairwise merge to avoid SIGKILL/OOM.
VIDEO_EXPORT_LOW_MEMORY=true
VIDEO_EXPORT_LOW_MEMORY_PRESET=ultrafast
VIDEO_EXPORT_LOW_MEMORY_THREADS=1
VIDEO_EXPORT_LOW_MEMORY_FILTER_THREADS=1
# When keep-segment count exceeds this, render one segment per FFmpeg call (avoids OOM).
VIDEO_EXPORT_LOW_MEMORY_MAX_FILTER_SEGMENTS=2
# AI denoise for audio_enhance_mode=ai (fillers still use Whisper separately).
# driver=arnndn (default) needs a .rnnn model path; driver=http needs https URL.
VIDEO_EXPORT_AI_DENOISE_DRIVER=arnndn
VIDEO_EXPORT_ARNNDN_MODEL=/app/storage/models/cb.rnnn
VIDEO_EXPORT_ARNNDN_MIX=0.8
#VIDEO_EXPORT_AI_DENOISE_DRIVER=http
#VIDEO_EXPORT_AI_DENOISE_URL=https://audio-cleaner.example/v1/denoise
#VIDEO_EXPORT_AI_DENOISE_TOKEN=
#VIDEO_EXPORT_AI_DENOISE_TIMEOUT=600

# ---- Product packages storage prefix ----
PRODUCT_PACKAGE_STORAGE_DISK=r2
PRODUCT_PACKAGE_STORAGE_DIRECTORY=ai/product-packages

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"


# ---- AI providers ----
# Select one: gemini | anthropic | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your_real_key_here
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_KEY=
# Required for Video Export AI mode (word timestamps). Default whisper-1 is fine.
OPENAI_WHISPER_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Resume Studio (Module 2 — AiResumeStudio) ----
CV_STUDIO_SCHEDULE_TIME=09:00
CV_STUDIO_SCHEDULE_TIMEZONE=Europe/Lisbon
CV_STUDIO_DEEP_EXTRACT_TOP_N=3
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
# Optional — enriches GitHub portfolio step (never logged)
GITHUB_TOKEN=

# ---- Tavily (research / web search) ----
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# ---- Products (Module 4 — content generator) ----
# Model used per topic by the generation pipeline (config/products.php).
PRODUCTS_AI_MODEL=gpt-4.1-mini

# ---- Context7 (library documentation verification) ----
# Optional: without a key the docs adapter degrades to "no snippets" and
# content generation continues ungrounded. Keys look like ctx7sk-…
CONTEXT7_API_KEY=
CONTEXT7_API_URL=https://context7.com
CONTEXT7_MAX_SNIPPETS=5

# ---- Replicate (image generation) ----
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-2-pro
REPLICATE_IMAGE_ASPECT_RATIO=16:9
REPLICATE_IMAGE_OUTPUT_FORMAT=webp
REPLICATE_IMAGE_OUTPUT_QUALITY=85
REPLICATE_IMAGE_SAFETY_TOLERANCE=2
REPLICATE_IMAGE_PROMPT_UPSAMPLING=true
REPLICATE_WAIT_SECONDS=25
REPLICATE_STORAGE_DISK=r2
REPLICATE_STORAGE_DIRECTORY=ai/campaigns
REPLICATE_STORAGE_DIRECTORY_POSTS=ai/posts

HASH_DRIVER=argon2id
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

AUTH_LOCKOUT_ATTEMPTS=3
AUTH_LOCKOUT_MINUTES=60
# false = opt-in from Profile “Enable 2FA”. true = force ADMIN/SUPER_ADMIN to /two-factor/setup.
AUTH_MANDATORY_2FA=false

AUTH_OTP_EXPIRES_MINUTES=2
AUTH_OTP_LENGTH=6
AUTH_OTP_VALID_CHARS=0123456789
AUTH_OTP_RESEND_INTERVAL_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=3
SESSION_LIFETIME=30

GOOGLE_MAPS_API_KEY=
APP_NAME_DESCRIPTION_TITLE=

GOOGLE_CALENDAR_AUTH_PROFILE=oauth
GOOGLE_CALENDAR_ID=argenis692@gmail.com
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI="${APP_URL}/google-calendar/oauth/callback"
REMOTE_ASSISTANCE_MEETING_PROVIDER=google_meet
MEETING_DURATION_MINUTES=30
MEETING_CALENDAR_MAX_DAYS=92

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
